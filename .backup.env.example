# ==============================================================================
# NEEI Web Portal - Variáveis de Ambiente para Backup Rclone + Cloudflare R2
# Copiar para /etc/neei-backup.env (na VPS) ou .backup.env (local)
# ==============================================================================

# Nome do remote encriptado configurado no rclone.conf (r2-crypt por omissão)
RCLONE_REMOTE="r2-crypt"

# Nome do bucket Cloudflare R2
RCLONE_BUCKET="siteneei-backups"

# Retenção: número de dias a manter as cópias de segurança na cloud (purge automático)
RETENTION_DAYS="30"

# Filtro para encontrar o contentor Docker do portal no Coolify (ex: siteneei)
CONTAINER_FILTER="siteneei"

# Caminho opcional direto para o ficheiro activities.db no sistema de ficheiros da VPS
# Se preenchido, o script usa este caminho em vez de invocar o docker exec
HOST_DB_PATH=""

# Webhook do Discord para receber notificações de sucesso ou falha no canal da equipa
DISCORD_WEBHOOK_URL=""
