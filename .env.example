# =============================================================================
# NEEI Web Portal - Variáveis de Ambiente
# Copia este ficheiro para .env para desenvolvimento local:
# Windows (PowerShell): Copy-Item .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Administração e Segurança (Obrigatório para o painel /admin)
# -----------------------------------------------------------------------------
ADMIN_PASSWORD=admin123
PORT=3000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# 2. Funcionalidades do Portal
# -----------------------------------------------------------------------------
# Controla a visibilidade pública do calendário de atividades (true/false)
SHOW_CALENDAR=true

# Chave da Google Gemini para o Tutor Quack (/api/analyze)
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 3. Loja de Merchandising & Pagamentos (Stripe)
# -----------------------------------------------------------------------------
# Controla se as sweats estão disponíveis para o público em geral (true/false)
SWEATS_AVAILABLE=true

# Ativa a loja de teste para administradores com preço de 0.50€ (mínimo Stripe)
# Permite testes reais sem limites de sandbox (true/false, predefinido: true)
SHOW_TEST_SHOP=true

# Chaves da Stripe (se vazias ou 'sandbox', o sistema ativa o modo de simulação local)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 4. Envio de Emails de Confirmação (Nodemailer SMTP)
# -----------------------------------------------------------------------------
# Se deixares vazio, os emails correm em modo DRY-RUN (imprime no terminal)
# Exemplo para Microsoft 365 (Email institucional neei@aaualg.pt):
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=neei@aaualg.pt
# SMTP_PASS=tua_senha_ou_app_password
# SMTP_FROM="NEEI - Núcleo de Estudantes de Engenharia Informática <neei@aaualg.pt>"

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# -----------------------------------------------------------------------------
# 5. Faturação Certificada AT (Moloni v1)
# -----------------------------------------------------------------------------
# Preencher assim que a conta Moloni da AAUAlg/NEEI estiver configurada.
# Se vazio, as encomendas ficam guardadas em modo pending_invoice sem bloquear vendas.
MOLONI_CLIENT_ID=
MOLONI_CLIENT_SECRET=
MOLONI_USERNAME=
MOLONI_PASSWORD=
MOLONI_COMPANY_ID=
